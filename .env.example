EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Entorno de registro push para desarrollo local. EAS lo define por perfil.
EXPO_PUBLIC_PUSH_ENVIRONMENT=development
# Archivo google-services.json de Firebase para Android (ruta local o variable File en EAS).
GOOGLE_SERVICES_JSON=
# Página web de la ubicación compartida (web/compartir/), p. ej. https://usuario.github.io/XimbalGo/compartir
EXPO_PUBLIC_URL_UBICACION_COMPARTIDA=
