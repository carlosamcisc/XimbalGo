EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Key de Maps SDK for Android restringida al paquete y SHA-1; solo se usa al compilar.
GOOGLE_MAPS_ANDROID_API_KEY=
# Key de Maps SDK for iOS restringida al bundle identifier; solo se usa al compilar.
# Sin ella, iOS muestra Apple Maps en lugar de Google Maps.
GOOGLE_MAPS_IOS_API_KEY=
# Página web de la ubicación compartida (web/compartir/), p. ej. https://usuario.github.io/XimbalGo/compartir
EXPO_PUBLIC_URL_UBICACION_COMPARTIDA=
