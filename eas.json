{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "EXPO_PUBLIC_PUSH_ENVIRONMENT": "development" },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_PUSH_ENVIRONMENT": "preview" },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "env": { "EXPO_PUBLIC_PUSH_ENVIRONMENT": "production" },
      "autoIncrement": true
    },
    "ios-unsigned": {
      "environment": "production",
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_PUSH_ENVIRONMENT": "production" },
      "developmentClient": false,
      "ios": {
        "simulator": false,
        "withoutCredentials": true,
        "buildConfiguration": "Release",
        "config": "ios-unsigned.yml"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
